{
  "name": "interstellar-settlement-protocol",
  "version": "0.4",
  "description": "Prototype for The Interstellar Settlement Protocol (ISP) browser-based multiplayer strategy game",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "bench:ticks": "node scripts/bench-ticks.mjs",
    "bench:messaging": "node scripts/bench-messaging.mjs",
    "bench:forums": "node scripts/bench-forums.mjs",
    "telemetry:d3": "node scripts/telemetry-d3.mjs",
    "load:test": "node scripts/load-test.mjs",
    "audit:csp": "node scripts/csp-audit.mjs",
    "dev": "node --watch-path=./server --watch-path=./public server/index.js",
    "check": "node --check server/index.js",
    "test": "node scripts/test-strict.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "playtest": "playwright test",
    "economy:model": "node scripts/economy-model.mjs",
    "combat:model": "node scripts/combat-model.mjs",
    "belt:model": "node scripts/belt-model.mjs",
    "probe:pacing": "node scripts/probe-pacing.mjs",
    "probe:chains": "node scripts/probe-chains.mjs",
    "probe:markets": "node scripts/probe-markets.mjs",
    "probe:combat": "node scripts/probe-combat.mjs",
    "probe:conglomerate": "node scripts/probe-conglomerate.mjs",
    "probe:tier4": "node scripts/probe-tier4.mjs",
    "check:design": "node scripts/design-check.mjs",
    "design:prune": "node scripts/design-allowlist-prune.mjs",
    "probe:tariffs": "node scripts/probe-tariffs.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "socket.io": "^4.8.1"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitest/coverage-v8": "^4.1.5",
    "jsdom": "^30.1.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "vitest": "^4.1.5"
  }
}
