{
  "name": "interstellar-settlement-protocol",
  "version": "0.3",
  "description": "Prototype for The Interstellar Settlement Protocol (ISP) browser-based multiplayer strategy game",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch-path=./server --watch-path=./public server/index.js",
    "check": "node --check server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.103.3",
    "bcryptjs": "^3.0.3",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.5",
    "supertest": "^7.2.2",
    "vitest": "^4.1.5"
  }
}
