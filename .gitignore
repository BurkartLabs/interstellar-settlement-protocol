node_modules/
data/state.json

obsidian/
npm-debug.log*

# Local env / secrets
.env
.env.*
!.env.example

# Test/debug output artifacts
test_output*
*.log
e2e/screenshots/
test-results/
# scripts/test-strict.mjs writes these during a run and deletes them after
.vitest-results.json
.vitest-hook-errors.json

# Local account snapshots. Never commit these: the copy that was in git history held 129 accounts with
# password hashes and refresh tokens, including two real addresses, in a public repository (Orchestrata AB#415).
# server/gameState.js recreates this file locally when it needs it and copes with it being absent.
data/accounts-snapshot.json
data/dominance.json
data/*accounts*.json

# What the server writes at runtime when ISP_DATA_DIR is unset: data/ is both the catalogues and, on a developer's
# machine, the world (server/game/catalog.js). Never commit these or ship them in an image (Bug #4806): they hold
# players' chat, mail and statements, and references-salt is the secret behind every record reference.
# tests/unit/runtimeDataIgnored.test.js fails when the server writes a file into data/ that is not listed here.
data/references-salt
data/telemetry
data/chat
data/messages
data/inbox
data/statements
data/*.jsonl
data/*.tmp
data/arbitration.json
data/kanbanState.json
data/concessions.json
data/control-history.json
data/itc.json
data/legacy-investments.json
data/lobbying.json
data/patents.json
data/stations-built.json
data/tariffs.json
